NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:8081

MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/caltec

JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
CODE_PEPPER=replace-with-a-long-random-code-pepper

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mailbox@example.com
SMTP_PASS=mailbox-password
SMTP_FROM="Caltec <mailbox@example.com>"
ADMIN_NOTIFICATION_EMAIL=info@caltec.com.pk

CLOUDINARY_CLOUD_NAME=cloud-name
CLOUDINARY_API_KEY=api-key
CLOUDINARY_API_SECRET=api-secret
CLOUDINARY_FOLDER=caltec/profile-images

ADMIN_EMAIL=admin@example.com
